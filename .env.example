# YouTube AI Research System - example environment variables

# Application identity
API_APP_NAME="YouTube AI Research System API"  # Human-friendly service name
API_APP_VERSION="1.0.0"  # Application version string

# Runtime environment
API_ENV=development  # Set to 'development' or 'production'
API_HOST=0.0.0.0  # Host/IP the backend should bind to
API_PORT=8000  # Port the backend listens on

# Logging
LOG_LEVEL=INFO  # Log level: DEBUG, INFO, WARNING, ERROR

# Security / API key
API_KEY="your-api-key-here"  # Optional API key for protecting the API (leave empty to disable)

# Database
DATABASE_PATH="data/database/youtube.db"  # Path to SQLite DB file used by the backend

# YouTube API
YOUTUBE_API_KEY="your-youtube-api-key"  # Required for collector to call YouTube Data API

# Ollama LLM provider
OLLAMA_BASE_URL="http://localhost:11434"  # Base URL for Ollama inference API
OLLAMA_MODEL="llama3.2:latest"  # Model identifier used by Ollama provider

# Workflow executor tuning
WORKFLOW_MAX_RETRIES=3  # Max retry attempts per workflow stage
WORKFLOW_STAGE_TIMEOUT=600  # Timeout (seconds) per workflow stage
WORKFLOW_LOG_PAGE_LIMIT=500  # Default pagination limit for workflow logs

# Frontend (Next.js) - public variables prefixed with NEXT_PUBLIC
NEXT_PUBLIC_API_BASE="http://localhost:8000"  # Frontend base URL for API calls

# Notes:
# - Copy this file to .env and update placeholders before running the application.
# - Keep sensitive values (API_KEY, YOUTUBE_API_KEY) secret and do not commit real keys to source control.
